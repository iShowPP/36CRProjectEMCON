{
  "manifest_version": 3,
  "name": "EMCON — Four Shields",
  "version": "1.1.0",
  "description": "Blocks phishing and scam chains, labels real vs. edited photos, checks sites against their privacy promises, and stops fingerprinting. Evidence, not AI guesses.",
  "minimum_chrome_version": "137",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "scripting", "webNavigation", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "pages/popup.html",
    "default_title": "EMCON",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/bridge.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
